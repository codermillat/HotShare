# Copy to keystore.properties (gitignored) and fill in.
# Used by scripts/build-apk.sh, scripts/build-aab.sh and app/build.gradle.
#
# For Google Play create a DEDICATED UPLOAD key — never reuse the sideload key:
#   keytool -genkeypair -keystore keystore/hotshare-upload.jks -alias hotshare \
#     -keyalg RSA -keysize 4096 -validity 10000
storeFile=keystore/hotshare-upload.jks
storePassword=
keyAlias=hotshare
keyPassword=